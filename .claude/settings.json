{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": ["Write(./docs/**/*.md)", "Edit(./docs/**/*.md)"]
  },
  "teammateMmode": "tmux",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); b=$(basename \"$f\"); case \"$b\" in .env|.env.local|.env.production|.env.development|.env.staging) echo '【安全網】.env 系ファイルへのアクセスはブロックされています。APIキー流出防止のため Claude からは参照・編集できません。構造を確認したい場合は .env.local.example を見てください。内容を変更したい場合は Masaru さん自身のエディタで直接編集してください。' >&2; exit 2 ;; esac; exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-commit-ascii.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rm -f \"${CLAUDE_PROJECT_DIR:-.}/.claude/flags/evaluator-running\"; exit 0"
          }
        ]
      }
    ],
    "Stop": []
  }
}
