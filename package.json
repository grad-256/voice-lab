{
  "name": "voice-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run lib/",
    "test:integration": "vitest run app/api/",
    "test:watch": "vitest",
    "pages:build": "pnpm dlx @cloudflare/next-on-pages",
    "pages:deploy": "pnpm dlx wrangler pages deploy .vercel/output/static",
    "pages:dev": "pnpm dlx wrangler pages dev .vercel/output/static"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.8.0",
    "next": "15.5.24",
    "next-intl": "^4.9.1",
    "pitchfinder": "^2.3",
    "posthog-js": "^1.364.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/next-on-pages": "^1.13.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.2",
    "wrangler": "^3.0.0"
  }
}
