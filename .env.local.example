# ──────────────────────────────────────────────────
# VoiceLab — Phase 0 API Keys
# このファイルをコピーして .env.local を作成し、各値を入力してください
# cp .env.local.example .env.local
# ──────────────────────────────────────────────────

# OpenAI (Whisper 音声認識)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic (Claude Haiku 対話AI)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs (テキスト→音声)
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=...

# ElevenLabs ボイスID（省略時は Bella を使用）
# ダッシュボード https://elevenlabs.io/voice-lab で確認
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
