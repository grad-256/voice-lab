# ──────────────────────────────────────────────────
# VoiceLab — Phase 1 API Keys
# このファイルをコピーして .env.local を作成し、各値を入力してください
# cp .env.local.example .env.local
# ──────────────────────────────────────────────────

# Supabase (認証・DB)
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# サービスロールキー（アカウント削除に使用。Settings > API > service_role）
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# OpenAI (Whisper 音声認識)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic (Claude Haiku 対話AI)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs (テキスト→音声)
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=...

# ElevenLabs ボイスID（省略時は Bella を使用）
# ダッシュボード https://elevenlabs.io/voice-lab で確認
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Posthog (アナリティクス)
# https://posthog.com → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare AI Gateway（香港ルーティング対策）
# 両方セットされた時だけ OpenAI/Anthropic への呼び出しが AI Gateway 経由になる。
# 未設定ならフォールバックで直接 api.openai.com / api.anthropic.com を叩く（従来挙動）。
# https://dash.cloudflare.com → AI → AI Gateway → Create Gateway
# Account ID は Cloudflare Dashboard 右下（または URL）から取得。
# CF_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CF_AI_GATEWAY_NAME=my-voice-lab

# Cloudflare AI Gateway の Authenticated Gateway モード用トークン（任意）
# Dashboard で「Authenticated Gateway」を ON にした場合は必須。
# トークンは Gateway 設定画面の「Create authentication token」から発行する
# （権限は Account → AI Gateway → Run のみ）。
# 未設定なら cf-aig-authorization ヘッダを付けず、Authentication OFF モードで通る。
# CF_AI_GATEWAY_TOKEN=cfut_...
